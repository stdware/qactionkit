<?xml version="1.0" encoding="UTF-8"?>
<actionExtension>

    <version>1.0</version>
    <id>org.qactionkit.test.widgets</id>

    <items>
        <action id="test.openFile" text="Open File" shortcut="Ctrl+O" />
        <action id="test.saveFile" text="Save File" shortcut="Ctrl+S" />
        <action id="test.exit" text="Exit" description="Exit the application" />
        <action id="test.about" text="About" />
        <!-- The menu shows the short text, and a command palette the text -->
        <action id="test.checkUpdate" text="Check for Updates" shortText="Check Update" />

        <menu id="test.mainMenu" topLevel="true" />
        <menu id="test.mainToolBar" topLevel="true" />
        <menu id="test.file" text="File" />
        <group id="test.fileActions" />
        <menu id="test.help" text="Help" />
    </items>

    <layouts>
        <menu id="test.mainMenu">
            <menu id="test.file">
                <!-- A group contributes a separator on each side -->
                <group id="test.fileActions">
                    <action id="test.openFile" />
                    <action id="test.saveFile" />
                </group>
                <!-- Redundant next to the separator of the group above -->
                <separator />
                <action id="test.exit" />
            </menu>
            <menu id="test.help">
                <action id="test.about" />
            </menu>
        </menu>

        <menu id="test.mainToolBar">
            <action id="test.openFile" />
            <stretch />
            <action id="test.about" />
        </menu>
    </layouts>

    <insertions>
        <!-- No anchor, which means "last" -->
        <insertion target="test.help">
            <action id="test.checkUpdate" />
        </insertion>
    </insertions>

</actionExtension>
