<?xml version="1.0" encoding="UTF-8"?>
<actionExtension>

    <version>1.0</version>
    <id>org.qactionkit.test.insertions</id>

    <items>
        <action id="test.plugin.hello" />
        <action id="test.plugin.bye" />
        <menu id="test.plugin.menu" />
    </items>

    <layouts>
        <menu id="test.plugin.menu">
            <action id="test.plugin.hello" />
        </menu>
    </layouts>

    <insertions>
        <!-- The target does not exist -->
        <insertion target="test.missing">
            <action id="test.plugin.hello" />
        </insertion>
        <!-- The target exists, but the sibling does not -->
        <insertion target="test.plugin.menu" anchor="after" relativeTo="test.missing">
            <action id="test.plugin.hello" />
        </insertion>
        <!-- The target already contains one of the entries -->
        <insertion target="test.plugin.menu" anchor="first">
            <separator />
            <action id="test.plugin.bye" />
            <action id="test.plugin.hello" />
        </insertion>
    </insertions>

</actionExtension>
