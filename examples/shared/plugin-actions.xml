<?xml version="1.0" encoding="UTF-8"?>
<actionExtension>

    <!-- Action extension version, required -->
    <version>1.0</version>

    <!-- Action extension ID, required -->
    <id>com.example.plugin</id>

    <!-- Configuration, optional -->
    <configuration>
        <defaultCatalog>core.catalog.plugins</defaultCatalog>

        <translationContext
            text="Plugin::ActionText"
            category="Plugin::ActionCategory"
            description="Plugin::ActionDescription"
        />

        <vars>
            <var key="PLUGIN_NAME" value="Plugin" />
        </vars>
    </configuration>

    <!-- Declaration: plugin items -->
    <items>
        <!-- Example: plugin actions -->
        <action id="plugin.showHello" text="Show Hello" description="Show hello text" />

        <!-- Example: a catalog of the application, declared again for the default catalog. The
             registry uses the declaration of the application, which is registered first, and
             this one if the application does not declare the catalog. -->
        <phony id="core.catalog.plugins" text="Plugins" />
    </items>

    <!-- Declaration: plugin insertions -->
    <insertions>
        <!-- Insertion item
             - target (required)
             - anchor (optional, values: first/front/last/back/before/after, default: last)
             - relativeTo (required when anchor is before or after)
        -->
        <insertion target="core.help" anchor="after" relativeTo="core.documentations">
            <action id="plugin.showHello" />
            <separator />
        </insertion>
    </insertions>

</actionExtension>